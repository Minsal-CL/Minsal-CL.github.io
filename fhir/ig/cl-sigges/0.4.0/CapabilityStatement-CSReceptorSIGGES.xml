  <url value="https://interoperabilidad.minsal.cl/fhir/ig/sigges/CapabilityStatement/CSReceptorSIGGES"/>
  <version value="0.4.0"/>
  <name value="CSReceptorSIGGES"/>
  <title value="Receptor SIGGES (capa de interoperabilidad en etapa 1, SIGGES en etapa 2)"/>
  <status value="draft"/>
  <experimental value="false"/>
  <date value="2026-09-30"/>
  <publisher value="Unidad de Interoperabilidad - MINSAL"/>
  <contact>
    <name value="Unidad de Interoperabilidad - MINSAL"/>
    <telecom>
      <system value="url"/>
      <value value="https://interoperabilidad.minsal.cl"/>
    </telecom>
  </contact>
  <description value="Lo que debe exponer quien recibe las notificaciones GES: la operación $process-message para los 7 documentos y la búsqueda de casos con sus garantías."/>
  <jurisdiction>
    <coding>
      <system value="urn:iso:std:iso:3166"/>
      <code value="CL"/>
      <display value="Chile"/>
    </coding>
  </jurisdiction>
  <kind value="requirements"/>
  <fhirVersion value="4.0.1"/>
  <format value="json"/>
  <implementationGuide value="https://interoperabilidad.minsal.cl/fhir/ig/sigges/ImplementationGuide/hl7.fhir.cl.minsal.sigges"/>
  <rest>
    <mode value="server"/>
    <documentation value="Toda interacción usa TLS 1.2 o superior. Los datos personales nunca viajan en la URL: la consulta por RUN se hace con POST [base]/EpisodeOfCare/_search."/>
    <security>
      <service>
        <coding>
          <system value="http://terminology.hl7.org/CodeSystem/restful-security-service"/>
          <code value="OAuth"/>
          <display value="OAuth"/>
        </coding>
      </service>
      <description value="OAuth 2.0 con grant_type=client_credentials. Cada client_id se asocia a uno o más códigos DEIS; el receptor rechaza un MessageHeader.sender que no corresponda al cliente autenticado."/>
    </security>
    <resource>
      <type value="EpisodeOfCare"/>
      <supportedProfile value="https://interoperabilidad.minsal.cl/fhir/ig/sigges/StructureDefinition/caso-ges"/>
      <interaction>
        <code value="search-type"/>
        <documentation value="Por POST [base]/EpisodeOfCare/_search. patient.identifier (encadenado) con system|valor del RUN."/>
      </interaction>
      <searchInclude value="EpisodeOfCare:condition"/>
      <searchRevInclude value="Task:focus"/>
      <searchParam>
        <name value="patient"/>
        <definition value="http://hl7.org/fhir/SearchParameter/clinical-patient"/>
        <type value="reference"/>
        <documentation value="Se usa encadenado: patient.identifier={system del RUN}|{RUN}. Obligatorio."/>
      </searchParam>
      <searchParam>
        <name value="status"/>
        <definition value="http://hl7.org/fhir/SearchParameter/EpisodeOfCare-status"/>
        <type value="token"/>
      </searchParam>
      <searchParam>
        <name value="type"/>
        <definition value="http://hl7.org/fhir/SearchParameter/clinical-type"/>
        <type value="token"/>
        <documentation value="Problema de salud GES (CSProblemaSaludGES)."/>
      </searchParam>
    </resource>
    <resource>
      <type value="Task"/>
      <supportedProfile value="https://interoperabilidad.minsal.cl/fhir/ig/sigges/StructureDefinition/garantia-oportunidad-ges"/>
      <supportedProfile value="https://interoperabilidad.minsal.cl/fhir/ig/sigges/StructureDefinition/cierre-caso-ges"/>
      <supportedProfile value="https://interoperabilidad.minsal.cl/fhir/ig/sigges/StructureDefinition/excepcion-garantia-ges"/>
      <documentation value="Las garantías las publica SIGGES; el establecimiento las obtiene con _revinclude=Task:focus en la búsqueda de casos."/>
      <interaction>
        <code value="read"/>
      </interaction>
    </resource>
    <operation>
      <extension url="http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation">
        <valueCode value="SHALL"/>
      </extension>
      <name value="process-message"/>
      <definition value="http://hl7.org/fhir/OperationDefinition/MessageHeader-process-message"/>
      <documentation value="Recibe un BundleNotificacionGES y responde, de forma síncrona, un BundleRespuestaGES (ok, transient-error o fatal-error). Idempotencia por identifier[folio] del recurso foco; reintento de transporte con el mismo Bundle.identifier."/>
    </operation>
  </rest>
  <messaging>
    <documentation value="Mensajería FHIR síncrona sobre REST ($process-message). Un documento SIGGES por mensaje; MessageHeader.focus[0] = documento y focus[1] = caso."/>
  </messaging>
</CapabilityStatement>