       fhir:ImplementationGuide.definition.resource.name [ fhir:value "MINSAL Localización" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Lugar físico u operacional: sede o edificio, dependencia interna con relevancia interoperable o regulatoria, o local farmacéutico (MIDAS o SAFIS). El establecimiento asistencial con código DEIS no es una localización: es una MINSAL Organización, y sus sedes y dependencias se relacionan con él mediante `managingOrganization`. Varios identificadores oficiales solo si representan el mismo lugar y la misma granularidad. Un lugar contenido en otro es otra localización, relacionada con `partOf`." ] ;
