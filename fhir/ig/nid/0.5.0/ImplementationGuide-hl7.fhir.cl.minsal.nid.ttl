       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Indice Maestro Paciente: \"Cliente Buscador PIXm\"" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "El CapabilityStatement del Actor Cliente Buscador MPI expresa los requisitos que pueden ser utilizados mientras se cumple con la normativa.\n\n* Uso de FHIR R4\n* Uso de estructura JSON o XML\n* Uso de la operación [$ihe-pix](https://profiles.ihe.net/ITI/PIXm/OperationDefinition/IHE.PIXm.pix)" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
