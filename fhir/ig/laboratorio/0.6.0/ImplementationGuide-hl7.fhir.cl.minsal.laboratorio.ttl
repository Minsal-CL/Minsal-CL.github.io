       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Organización participante en el flujo de laboratorio" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Perfil para representar establecimientos de origen, laboratorios ejecutores y otras organizaciones participantes en el intercambio de solicitudes y resultados de laboratorio. Extiende `MINSALPrestadorOrganizacional` (guía NID/HPD, Núcleo de Interoperabilidad de Datos), el núcleo normativo real de MINSAL para prestadores institucionales, en vez del perfil más laxo de CL-Core. Cierra [DT-009] junto con `PacienteLaboratorio` y `MinsalPractitionerLaboratorio`." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
