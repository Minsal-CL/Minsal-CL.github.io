         fhir:Extension.valueString [ fhir:value "NamingSystem" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/laboratorio/NamingSystem/NSRunPrestador> ;
         fhir:Reference.reference [ fhir:value "NamingSystem/NSRunPrestador" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "RUN de Prestador Individual (dominio HPD/MPI)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Dominio de identificador para el RUN (Rol Único Nacional) de un prestador individual (profesional o administrativo de salud), tal como lo usa el repositorio real `IG_hpd` (Maestro de Prestadores Individuales, MPI de MINSAL) en sus propios ejemplos de prestador. No debe confundirse con el dominio del RUN de paciente (ver `NSRunPacienteNid`), gestionado por un registro distinto (NID): un mismo número de RUN puede corresponder a un dominio u otro según el rol de la persona (ver Arquitectura). La definición y gobernanza de este dominio corresponde al MPI/IG_hpd, no a esta guía." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
