       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Bundle de solicitud con cinco prestaciones FONASA" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "TransacciÃ³n FHIR que crea cinco prestaciones FONASA pertenecientes a una misma solicitud de laboratorio. El paciente, el profesional solicitante y el laboratorio ejecutor se asumen preexistentes en el servidor de destino (ver Inicio, secciÃ³n \"Solicitud con mÃºltiples prestaciones\"), por lo que no se incluyen como entradas propias de este Bundle." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://interoperabilidad.minsal.cl/fhir/ig/laboratorio/StructureDefinition/MinsalBundleSolicitudLaboratorio" ;
