       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/laboratorio/StructureDefinition/MinsalBundleSolicitudLaboratorio> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/MinsalBundleSolicitudLaboratorio" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Bundle de Solicitud de Laboratorio MINSAL" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Perfil para el envío transaccional de una o más prestaciones de laboratorio que pertenecen a una misma orden. Exige al menos una entrada `MinsalServiceRequestLab` y valida que todas las entradas de solicitud comparten el mismo `requisition`. Paciente, profesional solicitante y establecimiento se asumen preexistentes en el servidor de destino (resueltos previamente mediante el flujo de identidad descrito en Arquitectura); por eso se incluyen aquí solo como entradas opcionales, para el establecimiento que decida enviarlos junto con la solicitud en vez de asumir su preexistencia." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
