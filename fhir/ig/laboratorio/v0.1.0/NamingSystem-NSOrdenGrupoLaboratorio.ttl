  ] ;
  fhir:NamingSystem.name [ fhir:value "OrdenGrupoLaboratorio"] ;
  fhir:NamingSystem.status [ fhir:value "active"] ;
  fhir:NamingSystem.kind [ fhir:value "identifier"] ;
  fhir:NamingSystem.date [ fhir:value "2026-09-21"^^xsd:date] ;
  fhir:NamingSystem.publisher [ fhir:value "Unidad de Interoperabilidad - MINSAL"] ;
