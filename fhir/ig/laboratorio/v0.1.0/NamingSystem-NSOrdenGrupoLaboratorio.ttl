# - resource -------------------------------------------------------------------

<https://interoperabilidad.minsal.cl/fhir/ig/laboratorio/NamingSystem/NSOrdenGrupoLaboratorio> a fhir:NamingSystem ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "NSOrdenGrupoLaboratorio"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: SistemaDeNombres NSOrdenGrupoLaboratorio</b></p><a name=\"NSOrdenGrupoLaboratorio\"> </a><a name=\"hcNSOrdenGrupoLaboratorio\"> </a><h3>Summary</h3><table class=\"grid\"><tr><td>Defining URL</td><td>https://interoperabilidad.minsal.cl/fhir/ig/laboratorio/NamingSystem/NSOrdenGrupoLaboratorio</td></tr><tr><td>Version</td><td>0.5.1</td></tr><tr><td>Name</td><td>OrdenGrupoLaboratorio</td></tr><tr><td>Status</td><td>active</td></tr><tr><td>Definition</td><td><div><p>Dominio de identificador para <code>ServiceRequest.requisition</code> (número de orden agrupadora que comparten todas las prestaciones de una misma solicitud de laboratorio, ver <code>MinsalServiceRequestLab.requisition</code>). El URI sigue el patrón <code>.../identificador/orden-grupo/{códigoEstablecimientoDEIS}</code>, uno distinto por establecimiento asignador, para evitar colisiones entre establecimientos que reutilicen el mismo número local de orden. El código numérico de este ejemplo (116105) corresponde al establecimiento usado en los ejemplos de esta guía; no es un valor fijo universal, cada establecimiento real recibe su propio URI reemplazando ese segmento por su propio código DEIS.</p>\n</div></td></tr><tr><td>Publisher</td><td>Unidad de Interoperabilidad - MINSAL</td></tr></table><h3>Identifiers</h3><table class=\"grid\"><tr><td><b>Type</b></td><td><b>Value</b></td><td><b>Preferred</b></td><td><b>Comment</b></td></tr><tr><td>URI</td><td>https://interoperabilidad.minsal.cl/fhir/ig/laboratorio/identificador/orden-grupo/116105</td><td>true</td><td>116105 = código DEIS del establecimiento de ejemplo; cada establecimiento real usa su propio código en este mismo patrón de URI.</td></tr></table></div>"
  ] ;
  fhir:DomainResource.extension [
     fhir:index 0 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-NamingSystem.url" ] ;
