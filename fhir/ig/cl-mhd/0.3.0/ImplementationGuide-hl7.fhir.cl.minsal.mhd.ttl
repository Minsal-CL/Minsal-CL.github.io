       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/mhd/StructureDefinition/MinsalProvideBundleMhd> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/MinsalProvideBundleMhd" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Bundle de publicación de documentos MINSAL (ITI-65, IHE MHD Minimal)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Bundle de ITI-65. Hereda IHE.MHD.Minimal.ProvideBundle: una entrada SubmissionSet 1..1 (perfil `MinsalSubmissionSetMhd`) y entradas DocumentReference 0..* (perfil `MinsalDocumentReferenceMhd`). El documento nuevo de un reemplazo y el PATCH del documento anterior viajan en este mismo Bundle." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 1 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "CapabilityStatement" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/mhd/CapabilityStatement/CapabilityStatementNodoCentralMhd> ;
         fhir:Reference.reference [ fhir:value "CapabilityStatement/CapabilityStatementNodoCentralMhd" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "CapabilityStatement del nodo central (índice nacional) MHD" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Describe las capacidades del nodo central de MINSAL para las transacciones IHE MHD de la fase 1 (modelo mediado, ver Arquitectura y flujos): responde búsquedas y recuperaciones de documentos (actuando como Document Responder) y recibe publicaciones de los nodos custodios (actuando como Document Recipient). Verifica el paciente de cada publicación contra el MPI nacional (actuando como consumidor PIXm, ITI-83). No declara interacciones propias: importa los CapabilityStatement oficiales de IHE MHD y PIXm que ya las definen, para no duplicar ni arriesgar que se desalineen de la especificación." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 2 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Organization" ]
       ] ;
