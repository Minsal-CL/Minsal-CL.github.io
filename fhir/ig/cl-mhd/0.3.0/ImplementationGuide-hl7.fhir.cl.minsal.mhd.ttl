       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Ejemplo orientado a imagenología: mismo perfil transversal que el ejemplo de laboratorio, cambiando `type`/`category` y el custodio. `type` usa LOINC 18748-4 'Diagnostic imaging study' (verificado como el código vigente para el tipo de documento de un informe de imágenes diagnósticas) y `category` usa v2-0074#RAD 'Radiology' (confirmado vigente; el código IMG del mismo CodeSystem está obsoleto)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://interoperabilidad.minsal.cl/fhir/ig/mhd/StructureDefinition/MinsalDocumentReferenceMhd" ;
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/mhd/StructureDefinition/MinsalDocumentReferenceMhd>
       ]
     ], [
       fhir:index 9 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "DocumentReference" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/mhd/DocumentReference/InformeLaboratorioEjemploMhd> ;
         fhir:Reference.reference [ fhir:value "DocumentReference/InformeLaboratorioEjemploMhd" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Referencia documental de un informe de laboratorio (forma almacenada)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Ejemplo orientado a laboratorio: mismo perfil transversal que el ejemplo de imagenología, cambiando `type`/`category` y el custodio. Representa la forma almacenada (ITI-67/68): el contenido se recupera por `content.attachment.url`, no viaja inline. Incluye `context.related` apuntando a `SolicitudEjemploMhd`, para ilustrar la trazabilidad hacia la solicitud de origen cuando esta viene codificada en un sistema distinto (ej. FONASA) del que usa el resultado (LOINC)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://interoperabilidad.minsal.cl/fhir/ig/mhd/StructureDefinition/MinsalDocumentReferenceMhd" ;
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/mhd/StructureDefinition/MinsalDocumentReferenceMhd>
       ]
     ], [
       fhir:index 10 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "DocumentReference" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/mhd/DocumentReference/InformeLaboratorioAtomizadoEjemploMhd> ;
         fhir:Reference.reference [ fhir:value "DocumentReference/InformeLaboratorioAtomizadoEjemploMhd" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Referencia documental de un informe de laboratorio atomizado (Bundle documento FHIR)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Ejemplo del modelo de contenido atomizado: `content.attachment.contentType` es `application/fhir+json` y la URL apunta a un Bundle documento FHIR (Composition + DiagnosticReport + Observation por resultado). Por regla de ITI-65, `hash` y `size` no se informan." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://interoperabilidad.minsal.cl/fhir/ig/mhd/StructureDefinition/MinsalDocumentReferenceMhd" ;
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/mhd/StructureDefinition/MinsalDocumentReferenceMhd>
       ]
     ], [
       fhir:index 11 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/mhd/StructureDefinition/MinsalDocumentReferenceMhd> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/MinsalDocumentReferenceMhd" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Referencia documental MINSAL (IHE MHD, forma almacenada)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Perfil transversal de DocumentReference (IHE MHD, perfil Minimal) para la forma almacenada y consultable de un documento clínico publicado en el Bus de Interoperabilidad: contiene los metadatos y la URL (`content.attachment.url`) desde la cual se recupera el contenido (transacciones ITI-67 y ITI-68). El contenido no va inline (`content.attachment.data` 0..0, heredado de IHE MHD Minimal). Las guías de dominio del portafolio (laboratorio, imagenología, etc.) heredan de este perfil y fijan lo específico de su documento; no reemplaza el perfil de dominio, lo complementa con la parte común a todas las guías." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
