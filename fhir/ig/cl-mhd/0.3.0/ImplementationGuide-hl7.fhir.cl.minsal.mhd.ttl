         fhir:Reference.reference [ fhir:value "ServiceRequest/SolicitudEjemploMhd" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Solicitud de examen de ejemplo (transversal, sin perfilar)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Solicitud de origen del informe de laboratorio de ejemplo, codificada con el código de prestación FONASA del hemograma (no LOINC: la solicitud y el resultado no siempre comparten sistema de codificación). Existe para demostrar `context.related` en `InformeLaboratorioEjemploMhd`: el resultado atomizado puede traer varios códigos LOINC (uno por cada componente del hemograma) y aun así trazarse hacia esta única solicitud de origen." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
     ] ;
