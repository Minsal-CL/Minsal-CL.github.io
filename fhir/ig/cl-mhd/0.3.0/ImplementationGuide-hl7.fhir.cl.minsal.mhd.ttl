  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xml:lang=\"es\" xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"es\"><p class=\"res-header-id\"><b>Generated Narrative: GuiaDeImplementacion hl7.fhir.cl.minsal.mhd</b></p><a name=\"hl7.fhir.cl.minsal.mhd\"> </a><a name=\"hchl7.fhir.cl.minsal.mhd\"> </a><div style=\"display: inline-block; background-color: #fbffeb; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\">Language: es</p></div><h2>MHDMinsal</h2><p>The official URL for this implementation guide is: </p><pre>https://interoperabilidad.minsal.cl/fhir/ig/mhd/ImplementationGuide/hl7.fhir.cl.minsal.mhd</pre><div><p>Perfil IHE Mobile access to Health Documents (MHD) transversal de MINSAL: define los elementos comunes a todo documento clínico publicado en el Bus de Interoperabilidad (ITI-65/67/68), para que las guías de dominio (Laboratorio, Imagenología, etc.) lo extiendan agregando su tipo de documento y contenido específico. Define el perfil de DocumentReference y los del envío ITI-65 (Provide Bundle y SubmissionSet), ilustrados con ejemplos de laboratorio e imagenología.</p>\n</div></div>"
  ] ;
  fhir:ImplementationGuide.url [ fhir:value "https://interoperabilidad.minsal.cl/fhir/ig/mhd/ImplementationGuide/hl7.fhir.cl.minsal.mhd"] ;
