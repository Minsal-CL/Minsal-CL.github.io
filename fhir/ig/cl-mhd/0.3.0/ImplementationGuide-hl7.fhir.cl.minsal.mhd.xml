      <reference>
        <reference value="DocumentReference/InformeLaboratorioAtomizadoEjemploMhd"/>
      </reference>
      <name value="Referencia documental de un informe de laboratorio atomizado (Bundle documento FHIR)"/>
      <description value="Ejemplo del modelo de contenido atomizado: `content.attachment.contentType` es `application/fhir+json` y la URL apunta a un Bundle documento FHIR (Composition + DiagnosticReport + Observation por resultado). Por regla de ITI-65, `hash` y `size` no se informan."/>
      <exampleCanonical value="https://interoperabilidad.minsal.cl/fhir/ig/mhd/StructureDefinition/MinsalDocumentReferenceMhd"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="StructureDefinition:resource"/>
      </extension>
      <reference>
        <reference value="StructureDefinition/MinsalDocumentReferenceMhd"/>
      </reference>
      <name value="Referencia documental MINSAL (IHE MHD, forma almacenada)"/>
      <description value="Perfil transversal de DocumentReference (IHE MHD, perfil Minimal) para la forma almacenada y consultable de un documento clínico publicado en el Bus de Interoperabilidad: contiene los metadatos y la URL (`content.attachment.url`) desde la cual se recupera el contenido (transacciones ITI-67 y ITI-68). El contenido no va inline (`content.attachment.data` 0..0, heredado de IHE MHD Minimal). Las guías de dominio del portafolio (laboratorio, imagenología, etc.) heredan de este perfil y fijan lo específico de su documento; no reemplaza el perfil de dominio, lo complementa con la parte común a todas las guías."/>
      <exampleBoolean value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="ServiceRequest"/>
      </extension>
      <reference>
        <reference value="ServiceRequest/SolicitudEjemploMhd"/>
      </reference>
      <name value="Solicitud de examen de ejemplo (transversal, sin perfilar)"/>
      <description value="Solicitud de origen del informe de laboratorio de ejemplo, codificada con el código de prestación FONASA del hemograma (no LOINC: la solicitud y el resultado no siempre comparten sistema de codificación). Existe para demostrar `context.related` en `InformeLaboratorioEjemploMhd`: el resultado atomizado puede traer varios códigos LOINC (uno por cada componente del hemograma) y aun así trazarse hacia esta única solicitud de origen."/>
      <exampleBoolean value="true"/>
    </resource>
