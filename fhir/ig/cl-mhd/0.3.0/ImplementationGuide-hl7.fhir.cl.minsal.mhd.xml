      <reference>
        <reference value="DocumentReference/InformeImagenologiaEjemploMhd"/>
      </reference>
      <name value="Referencia documental de un informe de imagenología (forma almacenada)"/>
      <description value="Ejemplo orientado a imagenología: mismo perfil transversal que el ejemplo de laboratorio, cambiando `type`/`category` y el custodio. `type` usa LOINC 18748-4 'Diagnostic imaging study' (verificado como el código vigente para el tipo de documento de un informe de imágenes diagnósticas) y `category` usa v2-0074#RAD 'Radiology' (confirmado vigente; el código IMG del mismo CodeSystem está obsoleto)."/>
      <exampleCanonical value="https://interoperabilidad.minsal.cl/fhir/ig/mhd/StructureDefinition/MinsalDocumentReferenceMhd"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="DocumentReference"/>
      </extension>
      <reference>
        <reference value="DocumentReference/InformeLaboratorioEjemploMhd"/>
      </reference>
      <name value="Referencia documental de un informe de laboratorio (forma almacenada)"/>
      <description value="Ejemplo orientado a laboratorio: mismo perfil transversal que el ejemplo de imagenología, cambiando `type`/`category` y el custodio. Representa la forma almacenada (ITI-67/68): el contenido se recupera por `content.attachment.url`, no viaja inline. Incluye `context.related` apuntando a `SolicitudEjemploMhd`, para ilustrar la trazabilidad hacia la solicitud de origen cuando esta viene codificada en un sistema distinto (ej. FONASA) del que usa el resultado (LOINC)."/>
      <exampleCanonical value="https://interoperabilidad.minsal.cl/fhir/ig/mhd/StructureDefinition/MinsalDocumentReferenceMhd"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
