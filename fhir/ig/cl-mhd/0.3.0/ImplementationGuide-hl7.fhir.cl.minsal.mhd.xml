      </reference>
      <name value="Reemplazo de un informe de laboratorio (depreca la versión anterior)"/>
      <description value="Ejemplo de la nueva versión de un documento que reemplaza a `InformeLaboratorioEjemploMhd`. `status` sigue en `current` porque este documento es el vigente; la deprecación del anterior se expresa con `relatesTo.code = replaces` apuntando a su `id`. En la transacción real (ver sección Reemplazo y deprecación de un documento), este `DocumentReference` viaja junto con un `PATCH` que cambia el `status` del documento anterior a `superseded`."/>
      <exampleCanonical value="https://interoperabilidad.minsal.cl/fhir/ig/mhd/StructureDefinition/MinsalDocumentReferenceMhd"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
