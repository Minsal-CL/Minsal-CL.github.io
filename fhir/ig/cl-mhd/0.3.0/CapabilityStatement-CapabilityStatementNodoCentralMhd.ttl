  fhir:CapabilityStatement.experimental [ fhir:value "true"^^xsd:boolean] ;
  fhir:CapabilityStatement.date [ fhir:value "2026-11-09"^^xsd:date] ;
  fhir:CapabilityStatement.publisher [ fhir:value "Unidad de Interoperabilidad - MINSAL"] ;
