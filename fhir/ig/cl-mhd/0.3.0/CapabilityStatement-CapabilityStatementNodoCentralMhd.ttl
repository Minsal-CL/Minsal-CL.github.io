  ] ;
  fhir:CapabilityStatement.implementation [
     fhir:CapabilityStatement.implementation.description [ fhir:value "Nodo central (índice nacional) del Bus de Interoperabilidad de MINSAL, en su rol de intermediario para la recuperación de documentos (modelo mediado, fase 1): recibe publicaciones de los nodos custodios y responde búsquedas/recuperaciones de los consumidores, reescribiendo `content.attachment.url` hacia su propio endpoint de recuperación." ]
  ] ;
