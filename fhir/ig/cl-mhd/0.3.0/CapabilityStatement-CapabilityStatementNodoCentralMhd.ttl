       fhir:ContactPoint.value [ fhir:value "https://interoperabilidad.minsal.cl" ]
     ]
  ] ;
  fhir:CapabilityStatement.description [ fhir:value "Describe las capacidades del nodo central de MINSAL para las transacciones IHE MHD de la fase 1 (modelo mediado, ver Arquitectura y flujos): responde búsquedas y recuperaciones de documentos (actuando como Document Responder) y recibe publicaciones de los nodos custodios (actuando como Document Recipient). Verifica el paciente de cada publicación contra el MPI nacional (actuando como consumidor PIXm, ITI-83). No declara interacciones propias: importa los CapabilityStatement oficiales de IHE MHD y PIXm que ya las definen, para no duplicar ni arriesgar que se desalineen de la especificación."] ;
  fhir:CapabilityStatement.jurisdiction [
     fhir:index 0 ;
     fhir:CodeableConcept.coding [
       fhir:index 0 ;
       fhir:Coding.system [ fhir:value "urn:iso:std:iso:3166" ] ;
       fhir:Coding.code [ fhir:value "CL" ] ;
       fhir:Coding.display [ fhir:value "Chile" ]
     ]
  ] ;
  fhir:CapabilityStatement.kind [ fhir:value "instance"] ;
  fhir:CapabilityStatement.imports [
     fhir:value "https://profiles.ihe.net/ITI/MHD/CapabilityStatement/IHE.MHD.DocumentResponder" ;
