       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Profesional de Imagenología MINSAL" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Perfil para representar al profesional solicitante del examen (ORC-12), al médico radiólogo que informa el estudio (OBR-32) y a cualquier otro profesional participante en el flujo imagenológico. Extiende MINSALPrestadorProfesional (NID), el núcleo normativo de MINSAL para prestadores individuales, según la jerarquía normativa nacional (decisión D-016). El RUN, la fecha de nacimiento y el título profesional quedan obligatorios por ese perfil, no por esta guía." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 23 ;
       fhir:Element.extension [
         fhir:index 0 ;
