       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Valores de control de la orden que el HIS envía en ORC-1 y describe en ORC-25 del mensaje ORM^O01." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
