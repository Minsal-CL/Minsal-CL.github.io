         fhir:Reference.reference [ fhir:value "CodeSystem/EstadoInformeRadiologicoHl7v2" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Estado del informe radiológico en HL7 v2" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Valores de estado del informe que el RIS envía en OBR-25 y OBX-11 del mensaje ORU^R01." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 10 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
