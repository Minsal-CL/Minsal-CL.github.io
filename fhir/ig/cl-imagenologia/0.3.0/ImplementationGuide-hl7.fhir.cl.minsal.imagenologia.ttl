         fhir:Reference.reference [ fhir:value "Practitioner/ProfesionalSolicitanteImagenEjemplo" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Profesional solicitante de ejemplo" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Profesional ficticio que solicita el examen imagenológico (ORC-12 del mensaje ORM^O01). Cumple el set de datos obligatorio de MINSALPrestadorProfesional (NID): RUN, nombre, fecha de nacimiento y título profesional, con el título tomado del CodeSystem de NID." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/MinsalPractitionerImagenologia" ;
