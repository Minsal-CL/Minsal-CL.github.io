       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/ConceptMap/EstadoInformeRadiologicoV2AFhir> ;
         fhir:Reference.reference [ fhir:value "ConceptMap/EstadoInformeRadiologicoV2AFhir" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Estado del informe radiológico: HL7 v2 a FHIR" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Equivalencias entre los estados del informe enviados por el RIS en OBR-25 / OBX-11 y los valores de DiagnosticReport.status." ] ;
