     ], [
       fhir:index 19 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/EstudioImagenologicoMinsal> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/EstudioImagenologicoMinsal" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Estudio Imagenológico MINSAL" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Perfil para representar el estudio de imagen almacenado en el PACS/VNA del proveedor: transporta el Accession Number, el Study Instance UID, la modalidad DICOM, el estado del estudio y la referencia al mecanismo de acceso a las imágenes (endpoint). El recurso contiene sólo metadatos: las imágenes permanecen en el PACS/VNA de origen (D-021). El Bus crea este recurso sólo cuando dispone de dato DICOM real (D-008), ya sea porque llega un evento de disponibilidad (MinsalBundleEstudioImagenologia) o porque acompaña al informe. Su ciclo de vida es independiente del informe radiológico (D-017): un estudio puede estar disponible sin informe." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 20 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ImagingStudy" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/ImagingStudy/EstudioTcCerebroEjemplo> ;
         fhir:Reference.reference [ fhir:value "ImagingStudy/EstudioTcCerebroEjemplo" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Estudio: TC de cerebro" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Estudio de imagen realizado en el RIS/PACS. Se crea porque el Bus dispone del Study Instance UID DICOM; sin ese dato el estudio no se crea y la trazabilidad la sostiene el Accession Number del informe. Ilustra además el escenario B de acceso a imágenes: imágenes disponibles e informe emitido. El informe (InformeTcCerebroEjemplo) referencia este estudio; el estudio no cambia por la llegada del informe y sigue referenciando el mecanismo de acceso del proveedor." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/EstudioImagenologicoMinsal" ;
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/EstudioImagenologicoMinsal>
       ]
     ], [
       fhir:index 21 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Bundle" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
