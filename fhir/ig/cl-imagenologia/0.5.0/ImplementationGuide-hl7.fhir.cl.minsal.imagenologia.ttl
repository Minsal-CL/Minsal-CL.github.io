       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Solicitud: TC de cerebro" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Solicitud de tomografía computada de cerebro generada por el HIS y recibida mediante ORM^O01. El identificador corresponde al examen dentro de la solicitud (ORC-2.1 / OBR-2.1) y requisition al número de solicitud que agrupa los exámenes (ORC-4.1), con el system del establecimiento asignador." ] ;
