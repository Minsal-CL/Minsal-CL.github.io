         fhir:Reference.reference [ fhir:value "Bundle/BundleDisponibilidadEstudioEjemplo" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Evento de disponibilidad: imágenes disponibles sin informe" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Transacción que el adaptador del proveedor envía al Bus cuando el PACS confirma que la mamografía tiene instancias almacenadas. El estudio viaja como actualización condicional por Study Instance UID: si el Bus recibe dos veces el mismo evento, el resultado es el mismo recurso. identifier es la clave de deduplicación del evento y timestamp su orden. El paciente viaja completo y como recurso nuevo con urn:uuid, conforme al perfil de NID (D-012): el emisor no conoce el identificador del maestro, y el Bus lo resuelve contra el MPI antes de publicar; sin coincidencia única el evento no se aplica (D-001, escenario E). El estudio no lleva basedOn porque el adaptador del proveedor no conoce el identificador de la solicitud en el repositorio nacional: el Bus la enlaza al resolver, igual que en el flujo del informe. La referencia al mecanismo de acceso sí es un identificador conocido por el proveedor, porque el Endpoint es parte del registro que administra MINSAL. No contiene imágenes, credenciales ni datos del informe." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/MinsalBundleEstudioImagenologia" ;
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/MinsalBundleEstudioImagenologia>
       ]
     ], [
       fhir:index 22 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/InformeRadiologicoMinsal> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/InformeRadiologicoMinsal" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Informe Radiológico MINSAL" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Perfil para representar el informe radiológico generado por el RIS y recibido mediante HL7 v2 ORU^R01, incluyendo el informe en PDF codificado en Base64. Sigue el modelo de ResultadoDiagnosticoLaboratorio de la Guía de Implementación de Laboratorio Clínico, con dos divergencias documentadas que impone la interfaz ORU-Out v1.3: basedOn y performer son opcionales." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 23 ;
       fhir:Element.extension [
