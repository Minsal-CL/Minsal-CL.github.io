     fhir:ImplementationGuide.definition.resource [
       fhir:index 0 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/MinsalBundleEstudioImagenologia> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/MinsalBundleEstudioImagenologia" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Bundle de Disponibilidad de Estudio Imagenológico MINSAL" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Perfil para el evento de disponibilidad de un estudio imagenológico: informa que un estudio está registrado o que sus imágenes están disponibles en el PACS/VNA del proveedor, con o sin informe radiológico (D-017, D-019). El evento puede originarse en el RIS, en el PACS o en un adaptador de integración; el proveedor lo entrega al Bus como transacción FHIR. El estudio viaja como actualización condicional por identificador, de modo que reenviar el mismo evento no duplica el recurso. Incluye el paciente, que el Bus resuelve contra el MPI antes de publicar (D-001, D-012). No transporta imágenes ni credenciales." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 1 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/MinsalBundleInformeImagenologia> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/MinsalBundleInformeImagenologia" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Bundle de Informe de Imagenología MINSAL" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Perfil para el envío transaccional del informe radiológico y, cuando exista dato DICOM, del estudio imagenológico asociado. Exige exactamente una entrada InformeRadiologicoMinsal. Es el artefacto que sostiene la trazabilidad del flujo ORU^R01: identifier conserva el MSH-10 del mensaje de origen, que en esta interfaz es la única red de seguridad, porque el emisor no reintenta. Sigue el modelo de MinsalBundleResultadoLaboratorio." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 2 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Bundle" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/Bundle/BundleInformeImagenEjemplo> ;
         fhir:Reference.reference [ fhir:value "Bundle/BundleInformeImagenEjemplo" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Bundle de informe radiológico con estudio imagenológico" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Transacción FHIR que publica el informe radiológico de la TC de cerebro junto con el estudio imagenológico al que corresponde. Incluye el paciente ya resuelto contra el MPI, que el Bus publica con el id del maestro (PUT). Es el resultado de transformar un mensaje ORU^R01. El informe y el estudio viajan como actualización condicional por identificador (D-025): el mismo Bundle crea el informe la primera vez y lo actualiza con cada versión sucesiva (P, F, C, A, D) sin duplicarlo. identifier conserva el MSH-10.1 y timestamp el MSH-7.1, que son la cadena de trazabilidad entre el mensaje recibido y los recursos publicados. La invariante informe-estudio-referenciado exige que, si el Bundle trae el estudio, el informe lo referencie." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/MinsalBundleInformeImagenologia" ;
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/MinsalBundleInformeImagenologia>
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Bundle" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/Bundle/BundleSolicitudImagenEjemplo> ;
         fhir:Reference.reference [ fhir:value "Bundle/BundleSolicitudImagenEjemplo" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Bundle de solicitud con dos exámenes imagenológicos" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Transacción FHIR que crea o actualiza, con actualización condicional por identificador (D-025), los dos exámenes de una misma solicitud (número 134): una tomografía computada de cerebro y una mamografía bilateral. Ambos comparten el par system+value de requisition. El paciente viaja como entrada obligatoria (D-012), ya resuelto contra el MPI y publicado con el id del maestro (PUT). El profesional solicitante y el servicio ejecutante se asumen preexistentes en el servidor de destino. identifier conserva el identificador del mensaje HL7 v2 de origen (MSH-10.1)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/MinsalBundleSolicitudImagenologia" ;
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/MinsalBundleSolicitudImagenologia>
       ]
     ], [
       fhir:index 4 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/MinsalBundleSolicitudImagenologia> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/MinsalBundleSolicitudImagenologia" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Bundle de Solicitud de Imagenología MINSAL" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Perfil para el envío transaccional de uno o más exámenes imagenológicos que pertenecen a una misma orden. Exige al menos una entrada MinsalServiceRequestImagen y valida que todas las entradas de solicitud comparten el mismo requisition. El paciente es obligatorio y conforme al perfil de NID (decisión D-012): en el canal FHIR directo lo envía el establecimiento, y en el canal HL7 v2 el Bus lo reconstruye desde el MPI (D-001). En ambos casos el Bus lo resuelve contra el MPI antes de publicar. Profesional solicitante y establecimiento se incluyen como entradas opcionales, para quien decida enviarlos en vez de asumir su preexistencia. Sigue el modelo de MinsalBundleSolicitudLaboratorio." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 5 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Bundle" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/Bundle/BundleSolicitudImagenFhirDirectoEjemplo> ;
         fhir:Reference.reference [ fhir:value "Bundle/BundleSolicitudImagenFhirDirectoEjemplo" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Bundle de solicitud enviado directamente en FHIR por un RCE" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Transacción que un RCE con integración FHIR nativa envía al Bus (Caso de uso 1, UC1-a). Incluye el paciente completo conforme al perfil de NID (decisión D-012) y dos exámenes de la misma solicitud, enviados con actualización condicional por identificador (D-025), que comparten el par system+value de requisition. El paciente viaja como recurso nuevo con urn:uuid: el Bus lo resuelve contra el MPI antes de publicar y una búsqueda sin coincidencias no autoriza crearlo (D-001). Los exámenes llevan el código local y la prestación FONASA; si el emisor entrega solo el código local, el Bus agrega FONASA antes de validar (D-014). Los códigos FONASA son ilustrativos y deben confirmarse con el servicio terminológico." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/MinsalBundleSolicitudImagenologia" ;
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/MinsalBundleSolicitudImagenologia>
       ]
     ], [
       fhir:index 6 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/EndpointAccesoImagenesMinsal> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/EndpointAccesoImagenesMinsal" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Endpoint de Acceso a Imágenes MINSAL" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Declaración, por parte de un proveedor RIS/PACS, del mecanismo mediante el cual un paciente accede a las imágenes de sus estudios en la infraestructura de origen: IHE Invoke Image Display (modalidad A), API del proveedor (modalidad B) o portal web del proveedor (modalidad C). El connectionType determina la modalidad y, con ella, el nivel de conformidad (D-020). El recurso describe la dirección del servicio; el contexto del estudio y los mecanismos de autenticación y autorización se resuelven en tiempo de ejecución y no se almacenan aquí. Un mismo Endpoint es referenciado por todos los estudios del proveedor que se acceden por ese mecanismo." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 7 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ImagingStudy" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/ImagingStudy/EstudioMamografiaDisponibleSinInformeEjemplo> ;
         fhir:Reference.reference [ fhir:value "ImagingStudy/EstudioMamografiaDisponibleSinInformeEjemplo" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Escenario A: estudio con imágenes disponibles e informe pendiente" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Mamografía bilateral realizada, con sus cuatro instancias almacenadas en el PACS del proveedor y sin informe radiológico emitido. status = available porque hay instancias asociadas; el estudio es visualizable porque referencia un mecanismo de acceso activo. La ausencia de informe se expresa por la ausencia de un InformeRadiologicoMinsal que referencie este estudio, no por un estado del estudio. procedureCode y basedOn permiten al portal mostrar de qué examen se trata." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/EstudioImagenologicoMinsal" ;
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/EstudioImagenologicoMinsal>
       ]
     ], [
       fhir:index 8 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ImagingStudy" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/ImagingStudy/EstudioRmRegistradoSinImagenesEjemplo> ;
         fhir:Reference.reference [ fhir:value "ImagingStudy/EstudioRmRegistradoSinImagenesEjemplo" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Escenario C: estudio registrado, imágenes todavía no disponibles" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Resonancia magnética agendada en el RIS, que ya asignó el Accession Number y el Study Instance UID (los publica en la lista de trabajo de la modalidad), pero el PACS aún no tiene instancias. status = registered y sin endpoint: el portal puede informar que el examen está registrado, pero no ofrece abrir imágenes. Registrar el examen no implica que las imágenes se puedan consultar." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/EstudioImagenologicoMinsal" ;
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/EstudioImagenologicoMinsal>
       ]
     ], [
       fhir:index 9 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ImagingStudy" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/ImagingStudy/EstudioTcTemporalmenteNoDisponibleEjemplo> ;
         fhir:Reference.reference [ fhir:value "ImagingStudy/EstudioTcTemporalmenteNoDisponibleEjemplo" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Escenario D: imágenes temporalmente no consultables" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Estudio cuyas imágenes estuvieron disponibles y hoy no pueden consultarse (por ejemplo, porque el proveedor las está migrando a otro archivo). status sigue en available, porque las instancias existen: volver a registered contradiría la semántica de FHIR R4. El proveedor retiró la referencia endpoint mientras dura la indisponibilidad y la repondrá con un nuevo evento cuando se restablezca (D-018)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/EstudioImagenologicoMinsal" ;
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/StructureDefinition/EstudioImagenologicoMinsal>
       ]
     ], [
       fhir:index 10 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "OperationOutcome" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/OperationOutcome/ResultadoImagenesNoDisponiblesEjemplo> ;
         fhir:Reference.reference [ fhir:value "OperationOutcome/ResultadoImagenesNoDisponiblesEjemplo" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Escenario D: imágenes temporalmente no disponibles al abrir el visor" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Respuesta cuando el mecanismo de acceso del proveedor no responde o informa que el estudio no puede abrirse en este momento. Es un error transitorio: el estado del estudio no cambia y el paciente puede reintentar más tarde." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 11 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "OperationOutcome" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/imagenologia/OperationOutcome/ResultadoPacienteNoResueltoEjemplo> ;
         fhir:Reference.reference [ fhir:value "OperationOutcome/ResultadoPacienteNoResueltoEjemplo" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Escenario E: estudio que no se vincula de forma inequívoca con el paciente" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Respuesta del Bus a un evento de disponibilidad cuyo paciente devuelve múltiples coincidencias en el MPI. El estudio no se publica y el evento queda en conciliación auditada; el paciente no lo ve en el portal hasta que la identidad se resuelva. La respuesta no repite datos personales del paciente." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 12 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "OperationOutcome" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
