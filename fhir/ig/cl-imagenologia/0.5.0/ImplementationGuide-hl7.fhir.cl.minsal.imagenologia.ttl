         fhir:Reference.reference [ fhir:value "OperationOutcome/ResultadoSesionExpiradaEjemplo" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Escenario F: sesión o apertura expirada" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Respuesta cuando la sesión del paciente en el portal, o la apertura de un solo uso del visor, expiró. El portal pide autenticarse de nuevo y genera una apertura nueva; nunca reutiliza la anterior." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 14 ;
       fhir:Element.extension [
