         fhir:Reference.reference [ fhir:value "OperationOutcome/ResultadoAccesoDenegadoEjemplo" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Escenario F: acceso denegado al abrir las imágenes" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Respuesta del servicio nacional de autorización cuando el paciente autenticado no está autorizado para el estudio solicitado (por ejemplo, el estudio pertenece a otra persona o la política de publicación lo retiene). El mensaje no revela si el estudio existe." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 13 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "OperationOutcome" ]
       ] ;
