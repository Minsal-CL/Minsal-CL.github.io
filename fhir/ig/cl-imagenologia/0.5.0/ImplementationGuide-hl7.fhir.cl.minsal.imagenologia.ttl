       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Informe radiológico sin solicitud previa" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Informe emitido por el RIS para un estudio que no tiene orden registrada en el Bus. Es el caso que justifica que basedOn sea opcional en esta guía: la interfaz de referencia ORU-Out v1.3 establece que el RIS envía todos los informes generados, no sólo los correspondientes a una orden del HIS. El informe se publica igual y el paciente accede a él." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
