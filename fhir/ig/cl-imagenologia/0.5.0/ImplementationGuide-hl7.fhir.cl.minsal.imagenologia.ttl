       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Solicitud: mamografía bilateral" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Segundo examen de la misma solicitud 134. Comparte con el primero el par system+value de requisition, que es lo que la invariante solicitud-imagen-requisition-compartido verifica en el Bundle. El motivo del estudio llega en OBR-31.2 y se conserva como texto: el catálogo de motivos de mamografía diagnóstica no forma parte de esta versión de la guía." ] ;
