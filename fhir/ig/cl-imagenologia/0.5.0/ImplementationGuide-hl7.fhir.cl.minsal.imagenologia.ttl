       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Organización participante en el flujo de imagenología" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Perfil para representar establecimientos de origen, servicios ejecutantes de imagenología, unidades de radiología y otras organizaciones participantes en el intercambio de solicitudes e informes. Extiende MINSALPrestadorOrganizacional (NID), el núcleo normativo de MINSAL para prestadores institucionales, según la jerarquía normativa nacional (decisión D-016). Sus reglas son idénticas a las de OrganizacionParticipanteLaboratorio." ] ;
