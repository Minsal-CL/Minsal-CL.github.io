       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Mecanismo de acceso: portal web del proveedor (modalidad C)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Portal web del proveedor en el que el paciente se autentica y busca su estudio. Es la modalidad de conformidad básica: el portal nacional dirige al paciente a la dirección de entrada, que no identifica al paciente ni al estudio." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
