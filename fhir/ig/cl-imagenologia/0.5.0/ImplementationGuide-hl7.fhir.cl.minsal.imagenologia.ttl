         fhir:Reference.reference [ fhir:value "Endpoint/EndpointIidVisorEjemplo" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Mecanismo de acceso: visor del proveedor invocado con IHE IID (modalidad A)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Visor web existente del proveedor, invocado mediante IHE Invoke Image Display. address es la URL de invocación IID, sin parámetros: el contexto del estudio (petición por estudio con su Study Instance UID, según RAD-106) se agrega en tiempo de ejecución. IID no autentica ni autoriza al paciente: el visor exige además la aserción de acceso del servicio nacional de autorización (D-022)." ] ;
