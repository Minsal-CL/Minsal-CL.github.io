       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Documento de la atención de urgencia" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Referencia al documento clínico de la atención (DAU o epicrisis de urgencia) en PDF. Permite a cualquier establecimiento de la red descubrir y descargar el detalle clínico completo." ] ;
