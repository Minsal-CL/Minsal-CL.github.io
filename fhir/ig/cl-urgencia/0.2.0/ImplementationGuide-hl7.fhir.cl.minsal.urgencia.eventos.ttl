     fhir:ImplementationGuide.definition.grouping [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "bundles" ] ;
       fhir:ImplementationGuide.definition.grouping.name [ fhir:value "Bundles por evento" ] ;
       fhir:ImplementationGuide.definition.grouping.description [ fhir:value "Un `Bundle` de tipo `transaction` por cada evento de la atención de urgencia (admisión, alta y abandono) y su estructura común." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "encuentro" ] ;
       fhir:ImplementationGuide.definition.grouping.name [ fhir:value "Encuentro de urgencia" ] ;
       fhir:ImplementationGuide.definition.grouping.description [ fhir:value "El episodio de urgencia (`Encounter`) y las reglas que debe cumplir en cada evento. Es un solo recurso que se actualiza en la admisión, el alta o el abandono." ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "clinicos" ] ;
       fhir:ImplementationGuide.definition.grouping.name [ fhir:value "Contenido clínico" ] ;
       fhir:ImplementationGuide.definition.grouping.description [ fhir:value "Diagnóstico, indicación de medicamentos al alta y referencia al documento clínico en PDF. Paciente, profesional y establecimiento usan directamente los perfiles del NID." ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "extensiones" ] ;
       fhir:ImplementationGuide.definition.grouping.name [ fhir:value "Extensiones" ] ;
       fhir:ImplementationGuide.definition.grouping.description [ fhir:value "Datos del CMBD de Urgencia sin elemento FHIR equivalente. Todas son opcionales." ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "conjuntos-valores" ] ;
       fhir:ImplementationGuide.definition.grouping.name [ fhir:value "Conjuntos de valores" ] ;
       fhir:ImplementationGuide.definition.grouping.description [ fhir:value "Códigos permitidos en cada elemento codificado de la guía." ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "sistemas-codigos" ] ;
       fhir:ImplementationGuide.definition.grouping.name [ fhir:value "Sistemas de códigos" ] ;
       fhir:ImplementationGuide.definition.grouping.description [ fhir:value "Códigos locales de la guía, tomados del CMBD de Urgencia del DEIS. Se mantienen experimentales hasta su publicación en el Servidor Terminológico Nacional." ]
     ], [
       fhir:index 6 ;
       fhir:Element.id [ fhir:value "ejemplos" ] ;
       fhir:ImplementationGuide.definition.grouping.name [ fhir:value "Ejemplos" ] ;
       fhir:ImplementationGuide.definition.grouping.description [ fhir:value "Un episodio con admisión y alta, otro cerrado por abandono (fuga), y los actores que participan." ]
     ] ;
     fhir:ImplementationGuide.definition.resource [
       fhir:index 0 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/urgencia-eventos/StructureDefinition/bundle-admision-urgencia> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bundle-admision-urgencia" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Bundle de admisión de urgencia" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Evento admisión: el paciente es admitido en urgencia. Abre el episodio (Encounter en in-progress) y avisa a la red que el paciente se encuentra en atención." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ] ;
       fhir:ImplementationGuide.definition.resource.groupingId [ fhir:value "bundles" ]
     ], [
       fhir:index 1 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/urgencia-eventos/StructureDefinition/bundle-alta-urgencia> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bundle-alta-urgencia" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Bundle de alta de urgencia" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Evento alta: el profesional da el alta de urgencia. Cierra el episodio (Encounter en finished) e informa diagnóstico de egreso, destino, medicamentos indicados y el documento clínico en PDF." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ] ;
       fhir:ImplementationGuide.definition.resource.groupingId [ fhir:value "bundles" ]
     ], [
       fhir:index 2 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/urgencia-eventos/StructureDefinition/bundle-abandono-urgencia> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bundle-abandono-urgencia" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Bundle de abandono de urgencia" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Evento abandono: el paciente se retira voluntariamente sin alta médica (fuga o NEA). Cierra el episodio (Encounter en finished). Si alcanzó a ser evaluado, puede incluir la hipótesis diagnóstica y el documento clínico." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ] ;
       fhir:ImplementationGuide.definition.resource.groupingId [ fhir:value "bundles" ]
     ], [
       fhir:index 3 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource:abstract" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/urgencia-eventos/StructureDefinition/bundle-urgencia> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/bundle-urgencia" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Bundle de urgencia (base)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Estructura común de los tres Bundle de urgencia. No se usa directamente: se usa el perfil del evento correspondiente." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ] ;
       fhir:ImplementationGuide.definition.resource.groupingId [ fhir:value "bundles" ]
     ], [
       fhir:index 4 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/urgencia-eventos/StructureDefinition/encuentro-urgencia> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/encuentro-urgencia" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Encuentro de urgencia" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Episodio de atención en una unidad de urgencia, desde la admisión hasta el alta o el abandono. Basado en EncounterCL de CL-Core. Es el recurso que la red usa para saber que el paciente estuvo en urgencia, cuándo y cómo terminó." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ] ;
       fhir:ImplementationGuide.definition.resource.groupingId [ fhir:value "encuentro" ]
     ], [
       fhir:index 5 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/urgencia-eventos/StructureDefinition/encuentro-urgencia-admision> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/encuentro-urgencia-admision" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Encuentro de urgencia - estado en la admisión" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Reglas del episodio de urgencia al momento de la admisión: abierto (in-progress), sin fecha de término ni destino. No es un recurso distinto: es el mismo Encounter que después se actualiza con el alta o el abandono." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ] ;
       fhir:ImplementationGuide.definition.resource.groupingId [ fhir:value "encuentro" ]
     ], [
       fhir:index 6 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/urgencia-eventos/StructureDefinition/encuentro-urgencia-alta> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/encuentro-urgencia-alta" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Encuentro de urgencia - estado en el alta" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Reglas del episodio de urgencia al momento del alta: cerrado (finished), con fecha de alta, destino y diagnóstico de egreso. No es un recurso distinto: es el mismo Encounter creado en la admisión (mismo ID DAU), actualizado." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ] ;
       fhir:ImplementationGuide.definition.resource.groupingId [ fhir:value "encuentro" ]
     ], [
       fhir:index 7 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/urgencia-eventos/StructureDefinition/encuentro-urgencia-abandono> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/encuentro-urgencia-abandono" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Encuentro de urgencia - estado en el abandono" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Reglas del episodio de urgencia cuando el paciente se retira voluntariamente sin alta médica (fuga o NEA): cerrado (finished), con la fecha y hora en que se constató el abandono y el tipo de abandono. No es un recurso distinto: es el mismo Encounter creado en la admisión (mismo ID DAU), actualizado." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ] ;
       fhir:ImplementationGuide.definition.resource.groupingId [ fhir:value "encuentro" ]
     ], [
       fhir:index 8 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/urgencia-eventos/StructureDefinition/diagnostico-urgencia> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/diagnostico-urgencia" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Diagnóstico de urgencia" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Hipótesis o diagnóstico de egreso de la atención de urgencia. Basado en CoreDiagnosticoCl de CL-Core. El tipo de diagnóstico del CMBD (hipótesis, confirmado, descartado) se expresa con `verificationStatus`." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ] ;
       fhir:ImplementationGuide.definition.resource.groupingId [ fhir:value "clinicos" ]
     ], [
       fhir:index 9 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interoperabilidad.minsal.cl/fhir/ig/urgencia-eventos/StructureDefinition/indicacion-medicamento-urgencia> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/indicacion-medicamento-urgencia" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Indicación de medicamento al alta" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Medicamento indicado al alta de urgencia para que el paciente continúe su tratamiento. Acepta nombre genérico y posología en texto libre (CMBD: INDICACIÓN DE FÁRMACOS e ID RECETA)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ] ;
       fhir:ImplementationGuide.definition.resource.groupingId [ fhir:value "clinicos" ]
     ], [
       fhir:index 10 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
